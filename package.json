{
  "name": "einao",
  "private": true,
  "packageManager": "pnpm@9.0.4",
  "scripts": {
    "dev": "pnpm --filter @einao/client dev",
    "dev:admin": "pnpm --filter @einao/admin dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter @einao/client build",
    "build:admin": "pnpm --filter @einao/admin build",
    "build:backend": "pnpm --filter backend build",
    "typecheck": "pnpm --filter @einao/client typecheck",
    "test": "pnpm --filter @einao/content test",
    "deploy:client": "pnpm --filter @einao/client run deploy",
    "deploy:admin": "pnpm --filter @einao/admin run deploy",
    "deploy:backend": "pnpm --filter backend run deploy",
    "check:client": "node scripts/check-client.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "kill-port": "^2.0.1",
    "playwright": "1.64.1"
  }
}